_wt_get_roles() {
    python3 -c "
import json
from pathlib import Path
try:
    data = json.loads((Path.home() / '.workload_tracker.json').read_text())
    for r in data.get('roles', []):
        print(r['id'])
except:
    pass
" 2>/dev/null
}

# Cached GitHub Project option lists (config.project_options_cache).
# Usage: _wt_get_project_options activity|type
_wt_get_project_options() {
    python3 -c "
import json, sys
from pathlib import Path
try:
    data = json.loads((Path.home() / '.workload_tracker.json').read_text())
    for o in data.get('config', {}).get('project_options_cache', {}).get(sys.argv[1], []):
        print(o)
except:
    pass
" "$1" 2>/dev/null
}


func norm(_ s) -> String {
  return s.lowercased()
}

// -1 when no cmux workspace corresponds to this task.
func wsIndexFor(_ key, _ title) -> Int {
  for i in 0..<workspaces.count {
    let d = workspaces[i].description
    if d != nil && d != "" && d.contains(key) {
      return i
    }
  }
  for i in 0..<workspaces.count {
    if norm(workspaces[i].title) == norm(title) {
      return i
    }
  }
  return -1
}

func roleColor(_ role) -> String {
  if role == "demokit" { return "#4C8DF6" }
  if role == "demos" { return "#3FB950" }
  if role == "strategic" { return "#A371F7" }
  if role == "testing" { return "#D29922" }
  return "#8B949E"
}

func statusIcon(_ status) -> String {
  if status == "inprogress" { return "play.circle.fill" }
  if status == "recurrent" { return "arrow.triangle.2.circlepath" }
  return "circle"
}

